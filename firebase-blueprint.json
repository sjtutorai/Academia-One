        "endDate": { "type": "string", "maxLength": 40 },
        "paymentMode": { "type": "string", "enum": ["manual", "online_pending"] },
        "paymentStatus": { "type": "string", "enum": ["paid_manual", "pending", "overdue", "trial"] },
