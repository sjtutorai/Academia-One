    "/rooms/{roomId}": { "schema": { "$ref": "#/entities/Room" }, "description": "School classrooms and exam halls" },
    "/teachers/{teacherId}": { "schema": { "$ref": "#/entities/TeacherProfile" }, "description": "School teacher staff records" },
    "/students/{studentId}": { "schema": { "$ref": "#/entities/StudentProfile" }, "description": "School student enrollment records" },
    "/timetablePeriods/{periodId}": { "schema": { "$ref": "#/entities/TimetablePeriod" }, "description": "Weekly timetable slots" },
    "/attendanceRecords/{recordId}": { "schema": { "$ref": "#/entities/AttendanceRecord" }, "description": "Daily attendance registers" },
    "/homework/{homeworkId}": { "schema": { "$ref": "#/entities/Homework" }, "description": "Homework assignments" },
    "/homeworkSubmissions/{submissionId}": { "schema": { "$ref": "#/entities/HomeworkSubmission" }, "description": "Student homework submissions" },
    "/examinations/{examId}": { "schema": { "$ref": "#/entities/Examination" }, "description": "Scheduled examinations" },
    "/examResults/{resultId}": { "schema": { "$ref": "#/entities/ExamResult" }, "description": "Examination marks and grades" },
    "/learningMaterials/{materialId}": { "schema": { "$ref": "#/entities/LearningMaterial" }, "description": "Teacher-uploaded study resources" },
    "/announcements/{announcementId}": { "schema": { "$ref": "#/entities/Announcement" }, "description": "School and class announcements" },
    "/notifications/{notificationId}": { "schema": { "$ref": "#/entities/Notification" }, "description": "User-scoped notifications" },
    "/notificationPreferences/{userId}": { "schema": { "$ref": "#/entities/NotificationPreferences" }, "description": "Per-user push and in-app notification preferences" },
    "/auditLogs/{logId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Immutable security and operations audit trail" },
    "/schoolApplications/{applicationId}": { "schema": { "$ref": "#/entities/SchoolApplication" }, "description": "Multi-step school applications pending Main Head approval" },
    "/applicationStatuses/{applicationNumber}": { "schema": { "$ref": "#/entities/ApplicationStatus" }, "description": "Public PII-free application status lookup keyed by Application Number" },
    "/schoolCodes/{code}": { "schema": { "$ref": "#/entities/SchoolCodeEntry" }, "description": "Exact-key school code lookup for member join requests" },
    "/emailDirectory/{emailKey}": { "schema": { "$ref": "#/entities/EmailDirectoryEntry" }, "description": "Normalized email-to-school role binding for Email/Password and Google login" },
    "/schoolJoinRequests/{requestId}": { "schema": { "$ref": "#/entities/SchoolJoinRequest" }, "description": "School Code join requests pending Principal approval" },
    "/adminSecurity/{docId}": { "schema": { "$ref": "#/entities/AdminSecurityConfig" }, "description": "Main Head 1-Step Verification password salted SHA-256 hash" }
  }
}
