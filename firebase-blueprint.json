      "required": ["id", "name", "tier", "priceMonthly", "billingInterval", "trialDays", "maxStudents", "maxTeachers", "storageGb", "enabledModules", "status", "createdAt", "updatedAt"]
    },
    "SchoolSubscription": {
      "title": "SchoolSubscription",
      "description": "Subscription assignment, manual/online payment record, and renewal history.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
