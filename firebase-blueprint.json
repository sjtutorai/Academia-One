      "description": "School-wide, class-specific, or role-specific announcement or coordinator flag.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 2000 },
        "audience": { "type": "string", "enum": ["school_wide", "class_specific", "role_specific", "principal_flag"] },
        "targetClassId": { "type": "string", "maxLength": 128 },
        "targetRole": { "type": "string", "maxLength": 32 },
        "attachmentName": { "type": "string", "maxLength": 160 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorRole": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["published", "scheduled", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "title", "body", "audience", "authorId", "authorName", "authorRole", "status", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app and push notification event for messages, task reminders, academic alerts, and special offers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["messages", "task_reminders", "academic", "special_offers", "system"] },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 600 },
        "linkRoute": { "type": "string", "maxLength": 160 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "schoolId", "category", "title", "body", "isRead", "createdAt"]
    },
    "NotificationPreferences": {
      "title": "NotificationPreferences",
      "description": "Per-user push and in-app notification delivery preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "browserPushEnabled": { "type": "boolean" },
        "inAppEnabled": { "type": "boolean" },
        "messages": { "type": "boolean" },
        "task_reminders": { "type": "boolean" },
        "academic": { "type": "boolean" },
        "special_offers": { "type": "boolean" },
        "system": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "browserPushEnabled", "inAppEnabled", "messages", "task_reminders", "academic", "special_offers", "system", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail for sensitive platform and school operations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 32 },
        "action": { "type": "string", "maxLength": 120 },
        "targetType": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetLabel": { "type": "string", "maxLength": 160 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "actorUid", "actorName", "actorRole", "action", "targetType", "targetId", "createdAt"]
    },
    "SchoolApplication": {
      "title": "SchoolApplication",
      "description": "Six-step authenticated school registration application submitted for Main Head review.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "applicationNumber": { "type": "string", "maxLength": 40, "pattern": "^[A-Z0-9_\\-]+$" },
        "applicantUid": { "type": "string", "maxLength": 128 },
        "applicantName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "applicantDesignation": { "type": "string", "maxLength": 64 },
        "applicantEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "applicantPhone": { "type": "string", "maxLength": 64 },
        "organizationName": { "type": "string", "maxLength": 200 },
        "preferredContactMethod": { "type": "string", "maxLength": 32 },
        "authorityRelationship": { "type": "string", "maxLength": 200 },
        "applicantIsPrincipal": { "type": "boolean" },
        "contactVerified": { "type": "boolean" },
        "schoolName": { "type": "string", "minLength": 2, "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "institutionType": { "type": "string", "maxLength": 64 },
        "affiliationBoard": { "type": "string", "maxLength": 120 },
        "mediumOfInstruction": { "type": "string", "maxLength": 120 },
        "establishedYear": { "type": "string", "maxLength": 32 },
        "externalRecognitionCode": { "type": "string", "maxLength": 64 },
        "logoDataUrl": { "type": "string", "maxLength": 500000 },
        "academicYear": { "type": "string", "maxLength": 40 },
        "website": { "type": "string", "maxLength": 300 },
        "schoolEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "schoolPhone": { "type": "string", "maxLength": 64 },
        "alternateContact": { "type": "string", "maxLength": 160 },
        "country": { "type": "string", "maxLength": 80 },
        "stateRegion": { "type": "string", "maxLength": 80 },
        "district": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 80 },
        "postalCode": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 500 },
        "campusAddress": { "type": "string", "maxLength": 500 },
        "classesOffered": { "type": "string", "maxLength": 800 },
        "classSectionPlan": { "type": "array" },
        "schoolPrefix": { "type": "string", "maxLength": 12 },
        "estimatedCoordinators": { "type": "number" },
        "estimatedStudents": { "type": "number" },
        "estimatedTeachers": { "type": "number" },
        "workingDaysSummary": { "type": "string", "maxLength": 120 },
        "principalName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "principalEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "principalPhone": { "type": "string", "maxLength": 64 },
        "principalDesignation": { "type": "string", "maxLength": 120 },
        "authMethod": { "type": "string", "enum": ["email_password", "google"] },
        "requestedPlanId": { "type": "string", "maxLength": 128 },
        "consentPolicyVersion": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["submitted", "under_review", "more_info_required", "approved", "rejected", "withdrawn"] },
        "internalNotes": { "type": "string", "maxLength": 2000 },
        "applicantMessage": { "type": "string", "maxLength": 1000 },
        "decisionNote": { "type": "string", "maxLength": 500 },
        "approvedSchoolId": { "type": "string", "maxLength": 128 },
        "approvedSchoolCode": { "type": "string", "maxLength": 24 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "activityLog": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "applicationNumber", "applicantName", "applicantEmail", "schoolName", "academicYear", "schoolEmail", "address", "principalName", "principalEmail", "authMethod", "requestedPlanId", "status", "createdAt", "updatedAt"]
    },
    "ApplicationStatus": {
      "title": "ApplicationStatus",
      "description": "PII-free public status mirror keyed by Application Number for verified self-service status tracking.",
      "type": "object",
      "properties": {
        "applicationNumber": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "enum": ["school", "member"] },
        "verificationEmailHash": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "requestedRole": { "type": "string", "enum": ["principal", "coordinator", "teacher", "student"] },
        "status": { "type": "string", "enum": ["submitted", "under_review", "more_info_required", "pending", "approved", "rejected", "withdrawn"] },
        "schoolCode": { "type": "string", "maxLength": 24 },
        "applicantMessage": { "type": "string", "maxLength": 1000 },
        "decisionNote": { "type": "string", "maxLength": 500 },
        "applicantResponseNote": { "type": "string", "maxLength": 1000 },
        "submittedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicationNumber", "type", "schoolName", "requestedRole", "status", "createdAt", "updatedAt"]
    },
    "SchoolCodeEntry": {
      "title": "SchoolCodeEntry",
      "description": "Exact-key public school code lookup with role counts and class-section mapping for role-specific member access codes.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 24 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "schoolName": { "type": "string", "maxLength": 140 },
        "status": { "type": "string", "enum": ["active", "trial", "suspended", "archived"] },
        "principalCode": { "type": "string", "maxLength": 32 },
        "coordinatorCount": { "type": "number" },
        "teacherCount": { "type": "number" },
        "studentCount": { "type": "number" },
        "classSections": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "schoolId", "schoolName", "status", "createdAt", "updatedAt"]
    },
    "EmailDirectoryEntry": {
      "title": "EmailDirectoryEntry",
      "description": "Normalized email-to-school binding used to auto-match Email/Password and Google logins to registered roles.",
      "type": "object",
      "properties": {
        "emailKey": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "schoolName": { "type": "string", "maxLength": 140 },
        "role": { "type": "string", "enum": ["principal", "coordinator", "teacher", "student"] },
        "displayName": { "type": "string", "maxLength": 120 },
        "linkedProfileId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "section": { "type": "string", "maxLength": 32 },
        "assignedClassIds": { "type": "array" },
        "coordinatorPermissions": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["emailKey", "email", "schoolId", "role", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "SchoolJoinRequest": {
      "title": "SchoolJoinRequest",
      "description": "Member join application submitted via School Code for review by the target school Principal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "applicationNumber": { "type": "string", "maxLength": 40 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "schoolCode": { "type": "string", "maxLength": 24 },
        "accessCode": { "type": "string", "maxLength": 32 },
        "schoolName": { "type": "string", "maxLength": 140 },
        "applicantUid": { "type": "string", "maxLength": 128 },
        "applicantEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "applicantName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "requestedRole": { "type": "string", "enum": ["coordinator", "teacher", "student"] },
        "requestedClassId": { "type": "string", "maxLength": 128 },
        "requestedSection": { "type": "string", "maxLength": 32 },
        "requestedClassInfo": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "decisionNote": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "applicationNumber", "schoolId", "schoolCode", "schoolName", "applicantUid", "applicantEmail", "applicantName", "requestedRole", "status", "createdAt", "updatedAt"]
    },
    "AdminSecurityConfig": {
      "title": "AdminSecurityConfig",
      "description": "Salted SHA-256 verification password hash for the Main Head 1-Step Verification gate (strictly Main Head readable/writable).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "passcodeHash": { "type": "string", "minLength": 32, "maxLength": 128 },
        "passcodeSalt": { "type": "string", "minLength": 16, "maxLength": 128 },
        "algorithm": { "type": "string", "enum": ["SHA-256-v1"] },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByEmail": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "passcodeHash", "passcodeSalt", "algorithm", "updatedByUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/PlatformUser" }, "description": "User profiles and RBAC role assignments" },
    "/schools/{schoolId}": { "schema": { "$ref": "#/entities/School" }, "description": "Tenant schools managed by Main Head" },
    "/subscriptionPlans/{planId}": { "schema": { "$ref": "#/entities/SubscriptionPlan" }, "description": "Platform subscription tiers" },
    "/schoolSubscriptions/{subId}": { "schema": { "$ref": "#/entities/SchoolSubscription" }, "description": "Per-school subscription assignments and renewal records" },
    "/schoolEnquiries/{enquiryId}": { "schema": { "$ref": "#/entities/SchoolEnquiry" }, "description": "Public school registration enquiries" },
    "/platformSettings/{settingId}": { "schema": { "$ref": "#/entities/PlatformSettings" }, "description": "Platform global settings" },
    "/classes/{classId}": { "schema": { "$ref": "#/entities/SchoolClass" }, "description": "School classes and sections" },
