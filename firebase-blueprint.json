{
  "entities": {
    "PlatformUser": {
      "title": "PlatformUser",
      "description": "Authenticated user profile with role, tenant school binding, and access status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-zA-Z0-9._\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": { "type": "string", "enum": ["main_head", "principal", "coordinator", "teacher", "student"] },
        "schoolId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended"] },
        "mustChangePassword": { "type": "boolean" },
        "phone": { "type": "string", "maxLength": 32 },
        "classId": { "type": "string", "maxLength": 128 },
        "section": { "type": "string", "maxLength": 32 },
        "assignedClassIds": { "type": "array" },
        "assignedSubjectIds": { "type": "array" },
        "coordinatorPermissions": { "type": "object" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "email", "displayName", "role", "schoolId", "status", "mustChangePassword", "createdAt", "updatedAt"]
    },
    "School": {
      "title": "School",
      "description": "Independent tenant school registered on AcademiaOne.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "code": { "type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[A-Z0-9_\\-]+$" },
        "address": { "type": "string", "maxLength": 300 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "academicYear": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "enum": ["active", "trial", "suspended", "archived"] },
        "principalUid": { "type": "string", "maxLength": 128 },
        "principalUsername": { "type": "string", "maxLength": 64 },
        "principalName": { "type": "string", "maxLength": 120 },
        "principalEmail": { "type": "string", "maxLength": 160 },
        "subscriptionPlanId": { "type": "string", "maxLength": 128 },
        "subscriptionStatus": { "type": "string", "enum": ["active", "trial", "grace_readonly", "expired"] },
        "subscriptionStart": { "type": "string", "maxLength": 40 },
        "subscriptionEnd": { "type": "string", "maxLength": 40 },
        "coordinatorCount": { "type": "number" },
        "teacherCount": { "type": "number" },
        "studentCount": { "type": "number" },
        "allocatedCoordinators": { "type": "number" },
        "allocatedTeachers": { "type": "number" },
        "allocatedStudents": { "type": "number" },
        "settings": { "type": "object" },
        "isDemo": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "code", "academicYear", "status", "subscriptionPlanId", "subscriptionStatus", "createdBy", "createdAt", "updatedAt"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "SaaS subscription tier configured by Main Head.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
