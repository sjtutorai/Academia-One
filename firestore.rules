    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(subjectId) && isSignedIn() && isValidSubject(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isPrincipalOf(incoming().schoolId));
      allow update: if isValidId(subjectId) && isSignedIn() && isValidSubject(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isPrincipalOf(existing().schoolId));
      allow delete: if isValidId(subjectId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /rooms/{roomId} {
      allow get: if isValidId(roomId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(roomId) && isSignedIn() && isValidRoom(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isPrincipalOf(incoming().schoolId));
      allow update: if isValidId(roomId) && isSignedIn() && isValidRoom(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isPrincipalOf(existing().schoolId));
      allow delete: if isValidId(roomId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(teacherId) && isSignedIn() && isValidTeacher(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isPrincipalOf(incoming().schoolId));
      allow update: if isValidId(teacherId) && isSignedIn() && isValidTeacher(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (
          isMainHead() ||
          isPrincipalOf(existing().schoolId) ||
          (isSameSchool(existing().schoolId) && request.auth.token.email is string && existing().email.lower() == request.auth.token.email.lower() && incoming().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'updatedAt']))
        );
      allow delete: if isValidId(teacherId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId) && isSignedIn() && (
        isMainHead() ||
        isStaffOf(existing().schoolId) ||
        (isSameSchool(existing().schoolId) && existing().userId == request.auth.uid) ||
        (isSameSchool(existing().schoolId) && request.auth.token.email is string && 'email' in existing() && existing().email.lower() == request.auth.token.email.lower())
      );
      allow list: if isSignedIn() && (
        isBootstrappedMainHead() ||
        (existing().schoolId == userDoc().schoolId && (userDoc().role != 'student' || existing().userId == request.auth.uid))
      );
      allow create: if isValidId(studentId) && isSignedIn() && isValidStudent(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isPrincipalOf(incoming().schoolId));
      allow update: if isValidId(studentId) && isSignedIn() && isValidStudent(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (
          isMainHead() ||
          isPrincipalOf(existing().schoolId) ||
          (isSameSchool(existing().schoolId) && request.auth.token.email is string && 'email' in existing() && existing().email.lower() == request.auth.token.email.lower() && incoming().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'updatedAt']))
        );
      allow delete: if isValidId(studentId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /timetablePeriods/{periodId} {
      allow get: if isValidId(periodId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(periodId) && isSignedIn() && isValidTimetablePeriod(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isCoordinatorOrPrincipalOf(incoming().schoolId));
      allow update: if isValidId(periodId) && isSignedIn() && isValidTimetablePeriod(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isCoordinatorOrPrincipalOf(existing().schoolId));
      allow delete: if isValidId(periodId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /attendanceRecords/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(recordId) && isSignedIn() && isValidAttendance(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(incoming().schoolId));
      allow update: if isValidId(recordId) && isSignedIn() && isValidAttendance(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(existing().schoolId));
      allow delete: if isValidId(recordId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /homework/{homeworkId} {
      allow get: if isValidId(homeworkId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(homeworkId) && isSignedIn() && isValidHomework(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(incoming().schoolId));
      allow update: if isValidId(homeworkId) && isSignedIn() && isValidHomework(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(existing().schoolId));
      allow delete: if isValidId(homeworkId) && isSignedIn() && (isMainHead() || isStaffOf(existing().schoolId));
    }

    match /homeworkSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (
        isMainHead() || isStaffOf(existing().schoolId) || existing().studentUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isBootstrappedMainHead() ||
        (existing().schoolId == userDoc().schoolId && (userDoc().role != 'student' || existing().studentUid == request.auth.uid))
      );
      allow create: if isValidId(submissionId) && isSignedIn() && isValidHomeworkSubmission(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(incoming().schoolId) || (isSameSchool(incoming().schoolId) && incoming().studentUid == request.auth.uid));
      allow update: if isValidId(submissionId) && isSignedIn() && isValidHomeworkSubmission(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (
          isMainHead() ||
          isStaffOf(existing().schoolId) ||
          (existing().studentUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'fileType', 'fileSizeKb', 'submissionText', 'submittedAt', 'isLate', 'reviewStatus', 'updatedAt']))
        );
      allow delete: if isValidId(submissionId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /examinations/{examId} {
      allow get: if isValidId(examId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(examId) && isSignedIn() && isValidExamination(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isCoordinatorOrPrincipalOf(incoming().schoolId));
      allow update: if isValidId(examId) && isSignedIn() && isValidExamination(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isCoordinatorOrPrincipalOf(existing().schoolId));
      allow delete: if isValidId(examId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
