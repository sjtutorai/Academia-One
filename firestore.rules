    match /examResults/{resultId} {
      allow get: if isValidId(resultId) && isSignedIn() && (
        isMainHead() ||
        isStaffOf(existing().schoolId) ||
        (isSameSchool(existing().schoolId) && existing().studentUid == request.auth.uid && existing().status == 'published')
      );
      allow list: if isSignedIn() && (
        isBootstrappedMainHead() ||
        (existing().schoolId == userDoc().schoolId && (userDoc().role != 'student' || (existing().studentUid == request.auth.uid && existing().status == 'published')))
      );
      allow create: if isValidId(resultId) && isSignedIn() && isValidExamResult(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(incoming().schoolId));
      allow update: if isValidId(resultId) && isSignedIn() && isValidExamResult(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(existing().schoolId));
      allow delete: if isValidId(resultId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /learningMaterials/{materialId} {
      allow get: if isValidId(materialId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(materialId) && isSignedIn() && isValidLearningMaterial(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(incoming().schoolId));
      allow update: if isValidId(materialId) && isSignedIn() && isValidLearningMaterial(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(existing().schoolId));
      allow delete: if isValidId(materialId) && isSignedIn() && (isMainHead() || isStaffOf(existing().schoolId));
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn() && (isMainHead() || isSameSchool(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().schoolId == userDoc().schoolId);
      allow create: if isValidId(announcementId) && isSignedIn() && isValidAnnouncement(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(incoming().schoolId));
      allow update: if isValidId(announcementId) && isSignedIn() && isValidAnnouncement(incoming())
        && incoming().id == existing().id && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && (isMainHead() || isStaffOf(existing().schoolId));
      allow delete: if isValidId(announcementId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (isMainHead() || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (isBootstrappedMainHead() || existing().userId == request.auth.uid);
      allow create: if isValidId(notificationId) && isSignedIn() && isValidNotification(incoming())
        && incoming().createdAt == request.time
        && (isMainHead() || isStaffOf(incoming().schoolId) || incoming().userId == request.auth.uid);
      allow update: if isValidId(notificationId) && isSignedIn() && isValidNotification(incoming())
        && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt
        && (isMainHead() || (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])));
      allow delete: if isValidId(notificationId) && isSignedIn() && (isMainHead() || existing().userId == request.auth.uid);
    }

    match /notificationPreferences/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isMainHead());
      allow list: if false;
      allow create: if isValidId(userId) && isSignedIn() && isValidNotificationPreferences(incoming())
        && request.auth.uid == userId && incoming().userId == userId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isSignedIn() && isValidNotificationPreferences(incoming())
        && request.auth.uid == userId && incoming().userId == existing().userId
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
      allow list: if isSignedIn() && (isBootstrappedMainHead() || (existing().schoolId == userDoc().schoolId && userDoc().role == 'principal'));
      allow create: if isValidId(logId) && isSignedIn() && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /schoolApplications/{applicationId} {
      allow get: if isValidId(applicationId) && isMainHead();
      allow list: if isBootstrappedMainHead() || (isSignedIn() && userDocExists() && userDoc().role == 'main_head');
      allow create: if isValidId(applicationId) && isValidSchoolApplication(incoming())
        && incoming().id == applicationId
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(applicationId) && isMainHead() && isValidSchoolApplication(incoming())
        && incoming().id == existing().id
        && incoming().applicationNumber == existing().applicationNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(applicationId) && isMainHead();
    }

    match /applicationStatuses/{applicationNumber} {
      allow get: if isValidId(applicationNumber);
      allow list: if false;
      allow create: if isValidId(applicationNumber) && isValidApplicationStatus(incoming())
        && incoming().applicationNumber == applicationNumber
        && incoming().status in ['submitted', 'pending']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(applicationNumber) && isValidApplicationStatus(incoming())
        && incoming().applicationNumber == existing().applicationNumber
        && incoming().type == existing().type
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isMainHead() ||
          (existing().type == 'member' && isPrincipalOf(existing().schoolId)) ||
          (existing().status == 'more_info_required' && incoming().status == 'submitted' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'applicantResponseNote', 'updatedAt']))
        );
      allow delete: if isValidId(applicationNumber) && isMainHead();
    }

    match /schoolCodes/{code} {
      allow get: if isValidId(code);
      allow list: if false;
      allow create: if isValidId(code) && isMainHead() && isValidSchoolCodeEntry(incoming())
        && incoming().code == code
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(code) && isMainHead() && isValidSchoolCodeEntry(incoming())
        && incoming().code == existing().code
        && incoming().schoolId == existing().schoolId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(code) && isMainHead();
    }

    match /emailDirectory/{emailKey} {
      allow get: if isValidId(emailKey) && isSignedIn() && (
        isMainHead() ||
        (request.auth.token.email is string && emailKey == authEmailKey()) ||
        (resource != null && isPrincipalOf(existing().schoolId))
      );
      allow list: if isSignedIn() && (
        isBootstrappedMainHead() ||
        (userDocExists() && userDoc().role == 'principal' && existing().schoolId == userDoc().schoolId)
      );
      allow create: if isValidId(emailKey) && isSignedIn() && isValidEmailDirectoryEntry(incoming())
        && incoming().emailKey == emailKey
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isMainHead() || (isPrincipalOf(incoming().schoolId) && incoming().role in ['coordinator', 'teacher', 'student']));
      allow update: if isValidId(emailKey) && isSignedIn() && isValidEmailDirectoryEntry(incoming())
        && incoming().emailKey == existing().emailKey
        && incoming().updatedAt == request.time
        && (isMainHead() || (isPrincipalOf(existing().schoolId) && incoming().schoolId == existing().schoolId && incoming().role in ['coordinator', 'teacher', 'student']));
      allow delete: if isValidId(emailKey) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }

    match /schoolJoinRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        isMainHead() ||
        isPrincipalOf(existing().schoolId) ||
        existing().applicantUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isBootstrappedMainHead() ||
        existing().applicantUid == request.auth.uid ||
        (userDocExists() && userDoc().role == 'principal' && existing().schoolId == userDoc().schoolId)
      );
      allow create: if isValidId(requestId) && isSignedIn() && isValidSchoolJoinRequest(incoming())
        && incoming().id == requestId
        && incoming().applicantUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(requestId) && isSignedIn() && isValidSchoolJoinRequest(incoming())
        && incoming().id == existing().id
        && incoming().schoolId == existing().schoolId
        && incoming().applicantUid == existing().applicantUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isMainHead() || isPrincipalOf(existing().schoolId));
      allow delete: if isValidId(requestId) && isSignedIn() && (isMainHead() || isPrincipalOf(existing().schoolId));
    }
  }
}
